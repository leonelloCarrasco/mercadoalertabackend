# Base de datos (ejemplo con Supabase — usa el connection string en modo "Transaction" del pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:tu-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Autenticación
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# API key para proteger las rutas /api/admin/* (invéntate un valor largo y random)
ADMIN_API_KEY=cambia-esto-por-otro-valor-largo-y-aleatorio

# API Mercado Público
MERCADOPUBLICO_TICKET=tu-ticket-real
COMPRAAGIL_TICKET=tu-ticket-de-compra-agil

# MercadoPago — opcional en desarrollo (si falta, los pagos se simulan en consola)
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-de-mercadopago
# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# URL donde vive el dashboard (opcional, por defecto https://dashboard.mercadoalerta.cl)
# Se usa para armar el link de recuperación de contraseña en el email.
FRONTEND_URL=https://dashboard.mercadoalerta.cl

TURNSTILE_SECRET_KEY=tu-turnstile-secret-key
ANTHROPIC_API_KEY=tu-anthropic-api-key
SUPPORT_EMAIL=tu-email-de-soporte
MERCADOPAGO_WEBHOOK_SECRET=mercadopago_webhook_secret

# Telegram — opcional en desarrollo (si falta, los mensajes se simulan en consola
# y el webhook de vinculación queda deshabilitado).
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=tu-telegram-bot-token
# El @username del bot (sin el @), para armar el link https://t.me/USERNAME?start=...
TELEGRAM_BOT_USERNAME=tu_bot_username
# Un secreto propio (cualquier string largo al azar) que configurás al dar de alta
# el webhook con setWebhook — Telegram lo reenvía en cada request para que puedas
# verificar que el llamado es realmente de Telegram y no de un tercero.
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-al-azar

# WhatsApp Cloud API (Meta) — opcional en desarrollo (si falta, los mensajes se
# simulan en consola).
#
# Solo el resumen de alertas (mensaje que MANDA el negocio) requiere una
# plantilla pre-aprobada por Meta — la vinculación de WhatsApp funciona con
# texto libre (el usuario le escribe primero a nuestro número), sin
# necesitar ninguna plantilla de código de verificación.
#
# Plantilla a crear y hacer aprobar en Meta Business Manager (puede tardar
# horas/días la primera vez), categoría "Utilidad":
#   "alerta_resumen" — cuerpo: "Tienes {{1}} nueva(s) oportunidad(es) que
#   coinciden con tus alertas en MercadoAlerta. Revisa tu panel para ver
#   el detalle." (si Meta la rechaza por sonar a otra categoría, ajustar el
#   texto — ver notas del proyecto).
WHATSAPP_ACCESS_TOKEN=tu-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
# Solo si le pusiste otro nombre a la plantilla en Meta Business Manager:
WHATSAPP_TEMPLATE_ALERTA_RESUMEN=alerta_resumen
WHATSAPP_TEMPLATE_IDIOMA=es

# El número de WhatsApp de tu negocio, en formato E.164 SIN el "+" (el mismo
# que verificaste en Meta) — se usa para armar el link https://wa.me/... que
# le mostramos al usuario para que te escriba y se vincule.
WHATSAPP_NUMERO_NEGOCIO=56912345678

# Un secreto propio (cualquier string largo al azar) que configurás al dar
# de alta el webhook en el dashboard de tu app de Meta — Meta te pide este
# mismo valor en el campo "Verify Token" al registrar la URL del webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=un-secreto-largo-al-azar

# El "App Secret" de tu app de Meta (Configuración de la app → Básica) — NO
# es el access token. Se usa para verificar que cada mensaje entrante
# realmente venga de Meta (firma HMAC en el header X-Hub-Signature-256).
WHATSAPP_APP_SECRET=tu-app-secret-de-meta