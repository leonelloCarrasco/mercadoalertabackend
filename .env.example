# Base de datos (ejemplo con Supabase — usa el connection string en modo "Transaction" del pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:tu-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Autenticación
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# API key para proteger las rutas /api/admin/* (invéntate un valor largo y random)
ADMIN_API_KEY=cambia-esto-por-otro-valor-largo-y-aleatorio

# API Mercado Público
MERCADOPUBLICO_TICKET=tu-ticket-real
COMPRAAGIL_TICKET=tu-ticket-de-compra-agil

# MercadoPago — opcional en desarrollo (si falta, los pagos se simulan en consola)
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-de-mercadopago
# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# URL donde vive el dashboard (opcional, por defecto https://dashboard.mercadoalerta.cl)
# Se usa para armar el link de recuperación de contraseña en el email.
FRONTEND_URL=https://dashboard.mercadoalerta.cl

TURNSTILE_SECRET_KEY=tu-turnstile-secret-key
ANTHROPIC_API_KEY=tu-anthropic-api-key
SUPPORT_EMAIL=tu-email-de-soporte
MERCADOPAGO_WEBHOOK_SECRET=mercadopago_webhook_secret

# Telegram — opcional en desarrollo (si falta, los mensajes se simulan en consola
# y el webhook de vinculación queda deshabilitado).
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=tu-telegram-bot-token
# El @username del bot (sin el @), para armar el link https://t.me/USERNAME?start=...
TELEGRAM_BOT_USERNAME=tu_bot_username
# Un secreto propio (cualquier string largo al azar) que configurás al dar de alta
# el webhook con setWebhook — Telegram lo reenvía en cada request para que puedas
# verificar que el llamado es realmente de Telegram y no de un tercero.
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-al-azar

# WhatsApp vía YCloud (BSP sobre WhatsApp Cloud API) — opcional en desarrollo
# (si falta, los mensajes se simulan en consola). Se eligió YCloud en vez de
# integrar directo con Meta por dos motivos: 1) la aprobación de plantillas
# de autenticación directo con Meta trababa mucho, y 2) Coexistencia
# (mantener la app de WhatsApp Business del celular activa junto con la
# API) requiere que quien conecta el número sea un "Tech Provider/Solution
# Partner" de Meta con Embedded Signup implementado — YCloud ya es ese
# socio, nosotros no.
#
# Solo el resumen de alertas (mensaje que MANDA el negocio) requiere una
# plantilla pre-aprobada — la vinculación de WhatsApp funciona con texto
# libre (el usuario le escribe primero a nuestro número), sin necesitar
# ninguna plantilla de código de verificación.
#
# Plantilla a crear y hacer aprobar (puede tardar horas/días la primera
# vez), categoría "Utilidad", con DOS variables:
#   {{1}} = nombre de pila del usuario (sin apellido)
#   {{2}} = cantidad y tipo ya armado como texto (ver
#           describirCantidadYTipo() en alerting.service.js), ej. "una
#           licitación", "2 compras ágiles", "5 licitaciones"
#   "alerta_resumen" — cuerpo: "Hola {{1}}, tienes {{2}} que coinciden con
#   tus alertas en MercadoAlerta. Revisa tu panel para ver el detalle."
#   (si la rechazan por sonar a otra categoría, ajustar el texto — ver
#   notas del proyecto).
#
# API Key: se genera en el dashboard de YCloud → Developer → API Keys.
YCLOUD_API_KEY=tu-ycloud-api-key
# Solo si le pusiste otro nombre a la plantilla:
WHATSAPP_TEMPLATE_ALERTA_RESUMEN=alerta_resumen
WHATSAPP_TEMPLATE_IDIOMA=es

# Plantillas de cambio de estado y recordatorio de cierre (ver
# seguimiento-estado.js y recordatorio-cierre.js) — mismo criterio que
# alerta_resumen: hay que crearlas y esperar la aprobación de Meta ANTES de
# activar el envío, si no YCloud devuelve error al mandar.
#
# Las tres llevan, además del cuerpo, un botón de tipo "Visitar sitio web"
# con URL DINÁMICA. Importante al crear el botón en Meta: la parte fija del
# dominio/ruta se define ahí (no se puede cambiar por mensaje), y solo el
# tramo final queda como {{1}} — nosotros mandamos el código de la
# licitación/compra ágil como ese parámetro dinámico.
#
#   "cambio_estado" (solo licitaciones — ver seguimiento-estado.js) recibe
#   CUATRO variables de cuerpo:
#     {{1}} = nombre de pila del usuario
#     {{2}} = nombre del proceso (licitación)
#     {{3}} = código externo
#     {{4}} = estado nuevo
#   cuerpo sugerido: "Hola {{1}}, {{2}} (código {{3}}) cambió de estado a
#   {{4}}. Revisa el detalle en tu panel de MercadoAlerta."
#   botón "Ver en Mercado Público" → URL base fija:
#     http://www.mercadopublico.cl/Procurement/Modules/RFB/DetailsAcquisition.aspx?idlicitacion={{1}}
#
#   "recordatorio_cierre_licitacion" y "recordatorio_cierre_compra_agil"
#   (recordatorio-cierre.js sí cubre ambos tipos, y como cada uno tiene
#   ficha en un dominio distinto, Meta obliga a separarlas en dos
#   plantillas — mismo cuerpo, distinto botón) reciben CUATRO variables:
#     {{1}} = nombre de pila del usuario
#     {{2}} = nombre del proceso
#     {{3}} = código externo
#     {{4}} = fecha de cierre ya formateada (es-CL)
#   cuerpo sugerido (igual en las dos): "Hola {{1}}, recuerda que {{2}}
#   (código {{3}}) cierra el {{4}}. Revisa el detalle en tu panel de
#   MercadoAlerta."
#   botón "Ver en Mercado Público" → URL base fija:
#     recordatorio_cierre_licitacion:
#       http://www.mercadopublico.cl/Procurement/Modules/RFB/DetailsAcquisition.aspx?idlicitacion={{1}}
#     recordatorio_cierre_compra_agil:
#       https://buscador.mercadopublico.cl/ficha?code={{1}}
#
# Solo si les pusiste otro nombre a las plantillas:
WHATSAPP_TEMPLATE_CAMBIO_ESTADO=cambio_estado_licitacion
WHATSAPP_TEMPLATE_RECORDATORIO_CIERRE_LICITACION=recordatorio_cierre_licitacion
WHATSAPP_TEMPLATE_RECORDATORIO_CIERRE_COMPRA_AGIL=recordatorio_cierre_compra_agil

# Tope mensual de mensajes de WhatsApp por empresa (cuota = limiteAlertas x
# 10, ver whatsapp.service.js). Sin esta variable, el sistema queda en modo
# "solo medir": cuenta y muestra el consumo en Mi Perfil, pero NUNCA corta
# ningún envío — es el modo seguro por default mientras se calibra el
# múltiplo real con datos de uso (recomendado: 4-6 semanas antes de poner
# esta fecha). Una vez definida, desde esa fecha en adelante el tope
# empieza a cortar de verdad (Email/Telegram siguen sin restricción).
# Formato: cualquier fecha parseable por `new Date(...)`, ej. 2026-09-15
# WHATSAPP_CUOTA_ENFORZAR_DESDE=2026-09-15

# El número de WhatsApp de tu negocio, en formato E.164 CON el "+" (el mismo
# que registraste en YCloud) — se usa tanto para mandar mensajes como para
# armar el link https://wa.me/... que le mostramos al usuario para vincularse.
YCLOUD_BUSINESS_NUMBER=+56912345678

# Un secreto propio que configurás al dar de alta el endpoint del webhook en
# el dashboard de YCloud (Developer → Webhooks) — se usa para verificar la
# firma HMAC que YCloud manda en el header YCloud-Signature en cada request.
YCLOUD_WEBHOOK_SECRET=un-secreto-largo-al-azar